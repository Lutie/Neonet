<div class="table-responsive table-hover">
    <table id="bill-list" class="table table-bordered table-striped">

        <thead>
            <td class="col-xs-1 text-center sorter-false filter-false">Devis (PDF)</td>
            <td class="col-xs-1 text-center sorter-false filter-false">Facture (PDF)</td>
            <td class="col-xs-1 text-center">Titre</td>
            <td class="col-xs-1 text-center">Client</td>
            <td class="col-xs-1 text-center">Création</td>
            <td class="col-xs-1 text-center">Dernière</br>modification</td>
            <td class="col-xs-1 text-center">Montant</td>
            <td class="col-xs-1 text-center">Ordre d'achat</td>
            <td class="col-xs-1 text-center">N° de Facture</td>
            <td class="col-xs-1 text-center sorter-false filter-false">Modifier</td>
            <td class="col-xs-1 text-center sorter-false filter-false">Supprimer</td>
        </thead>

        <tbody>
        {% set mon_token = csrf_token('NNC_BILL_SECURITY_TOKEN') %}
        {% for bill in bills %}
            <tr>
                <td class="text-center">
                    <a href="{{ path('invoice-pdf', { id:bill.id }) }}" target="_blank"><i class="fas fa-file-pdf fa-2x"></i></a>
                </td>
                <td class="text-center">
                    <a href="{{ path('bill-pdf', { id:bill.id }) }}" target="_blank"><i class="fas fa-file-pdf fa-2x"></i></a>
                </td>
                <td class="text-center">{{ bill.name }}</td>
                <td class="text-center">{{ bill.client }}</td>
                <td class="text-center" data-sort="{{ bill.date|date("Ymd") }}">{{ bill.date|date("d/m/Y") }}</td>
                <td class="text-center" data-sort="{{ bill.modificationDate|date("Ymd") }}">{{ bill.modificationDate|date("d/m/Y") }}</td>
                <td class="text-center">{{ bill.price }} €</td>
                <td class="text-center">
                    {% if bill.purchaseOrder %}
                        {{ bill.purchaseOrder }}
                    {% else %}
                        <button type="button"
                            data-toggle="modal"
                            data-target="#poModal-{{ bill.id }}">✏️</button>

                        {# Modale unique par ligne (id suffixé par bill.id) #}
                        <div class="modal fade" id="poModal-{{ bill.id }}" tabindex="-1" role="dialog" aria-labelledby="poModalLabel-{{ bill.id }}" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <form method="post"
                                    action="{{ path('bill_set_po', { id: bill.id }) }}"
                                    class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="poModalLabel-{{ bill.id }}">Numéro de bon de commande</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                                    <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <div class="form-group">
                                    <label for="purchaseOrder-{{ bill.id }}">Valeur</label>
                                    <input type="text"
                                        id="purchaseOrder-{{ bill.id }}"
                                        name="purchaseOrder"
                                        class="form-control"
                                        required>
                                    </div>
                                    <input type="hidden" name="_token" value="{{ csrf_token('set_po_' ~ bill.id) }}">
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-dismiss="modal">Annuler</button>
                                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    {% endif %}
                </td>
                <td class="text-center">{{ bill.billNumber }}</td>
                <td class="text-center">
                    <a href="{{ path('bill-modify', { id:bill.id, token:mon_token }) }}">✏️</a>
                </td>
                <td class="text-center">
                    <a href="{{ path('bill-delete', { id:bill.id, token:mon_token }) }}"
                       class="confirmation-required" data-text="La facture sera définitivement supprimée.">🗑️</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>