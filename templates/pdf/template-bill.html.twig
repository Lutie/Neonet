<!DOCTYPE html>
<html xml:lang="fr" lang="fr">
<head>
    <meta charset="utf8mb4"/>

    {#<meta http-equiv="X-UA-Compatible" content="IE=edge">#}
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    {# Bootstrap v4.0.0 #}
    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">

    <title>{{ fullBill ? 'Facture' : 'Devis'}}</title>

</head>
<body>

    <table class="table table-bordered table-striped">
        <tr>
            <th style="width:50%;"></th>
            <th>
                Client
            </th>
        </tr>
        <tr>
            <th style="width:50%;">
                <img src="{{ nncLogoUrl }}" style="width: 200px">
                <!-- à réactiver quand le partner aura un logo
                    <img src="{{ partnerLogoUrl }}" style="width: 100px">
                -->
                <p style="color: #34a4eb">N° SIREN : {{ siren }}</p>
                <p>{{ addressTop }}<br>
                {{ addressBottom }}</p>
                <p>{{ billPhone }}</p>
                <p>{{ billEmail }}</p>
            </th>
            <th>
                {% include 'pdf/address.html.twig' with {'date': datas.date, 'code': bill.client.code} %}
            </th>
        </tr>
        <tr>
            <p>{{ fullBill ? 'Facture' : 'Devis'}} - {{ fullBill ? datas.billNumber : datas.number }} - <strong>{{ datas.title }}</strong></p>
            {% if not fullBill %}
            <p style="font-size: 12px; opacity: 0.75; font-style: italic;">(Ce document est édité à titre provisoire et est valable pour une durée de un mois après édition)</p>
            {% endif %}
        </tr>
        {% if fullBill %}
        <p>Commande d'achat : {{ bill.purchaseOrder }}, Date d'émission : {{ bill.fullBillDate|date("d/m/Y") }}, <b>Date d'échéance : {{ bill.getDueDate|date("d/m/Y") }}</b>
        {% endif %}
    </table>

    {% for service in datas.services %}
        <table class="table table-bordered table-striped" style="font-size: 12px">
            <tr>
                <th colspan="4">
                    {{ service.name }}
                </th>
            </tr>
            {% for item in service.datas %}
                <tr>
                    <th style="padding:2px 6px; line-height:1.2;">
                        <label>{{ item.name }}</label>
                    </th>
                    <th class="text-center" style="padding:3px 6px; line-height:1.2;">{{ item.quantity }}</th>
                    <th class="text-center" style="padding:3px 6px; line-height:1.2;">x {{ item.price }} €</th>
                    <th class="text-center" style="padding:3px 6px; line-height:1.2;">{{ item.total > 0 ? '= ' ~ item.total ~ ' €' : 'gratuit' }}</th>
                </tr>
            {% endfor %}
        </table>
    {% endfor %}

    {% if datas.description != '' %}
        <p><strong>Commentaire(s)</strong></p>
        <p style="white-space: pre-line">{{ datas.description }}</p>
    {% endif %}

    {% if fullBill %}
    <table class="table table-bordered table-striped">
        <tr>
            <th class="text-center"><label for="bill_total">Total HT</label></th>
            <th class="text-center">{{ datas.price }} € (HT)</th>
        </tr>
        <tr>
            <th class="text-center"><label for="bill_total">Total TVA ({{ datas.tva }}%)</label></th>
            <th class="text-center">{{ datas.price_from_tva }} €</th>
        </tr>
        <tr>
            <th class="text-center"><label for="bill_total">Total TTC</label></th>
            <th class="text-center">{{ datas.price_with_tva }} € (TTC)</th>
        </tr>
    </table>
    {% else %}
    <table class="table table-bordered table-striped">
        <tr>
            <th class="text-center">
                <label for="bill_total">Total</label>
            </th>
            <th class="text-center">
                {{ datas.price }} € (HT) <br>
                <span style="font-size: 12px; opacity: 0.75; font-style: italic;">(montant hors taxes, la TVA est ajoutée et calculée en fonction de la TVA en rigueur)</span>
            </th>
        </tr>
    </table>
    {% endif %}

    {% if fullBill %}
    <table class="table table-bordered" style="margin-top: 12px;">
    <tr>
        <td style="width:65%; vertical-align:top;">
        <p>
            <strong>Mode règlement :</strong> VIREMENT 30 JOURS.
            <span style="float:right;"> N° TVA intracom : {{ tvaIntracom }}</span>
        </p>
        <p style="font-size:12px;">
            En cas de retard de paiement, une pénalité égale à 3 fois le taux d'intérêt légal sera exigible
            (Décret 2009-138 du 9 février 2009). Pour les professionnels, une indemnité minimum forfaitaire
            de 40 euros pour frais de recouvrement sera exigible (Décret 2012-1115 du 9 octobre 2012).
        </p>
        <p><strong>Coordonnées bancaires société :</strong></p>
        <p>
            Banque : {{ bankName }}<br>
            IBAN : {{ bankIban }}&nbsp;&nbsp;&nbsp;&nbsp;BIC : {{ bankBic }}
        </p>
        </td>
    </tr>
    </table>
    {% endif %}
</body>
